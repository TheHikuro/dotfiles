# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets & clés
*.akka_license
.env
.env.local
*.pem
*.key

# NuShell history (données locales)
.config/nushell/history.txt

# fish : variables universelles + completions générées (état local, pas de config)
# L'historique fish vit dans ~/.local/share/fish/, hors du repo.
.config/fish/fish_variables
.config/fish/completions/
.config/fish/conf.d/*_generated.fish

# peon-ping runtime state (données locales)
.claude/hooks/peon-ping/.state.json
.claude/hooks/peon-ping/.sound.pid
.claude/hooks/peon-ping/.last_update_check
.claude/hooks/peon-ping/*.log

# herdr : logs runtime écrits à côté de config.toml
.config/herdr/*.log

# Caches
.cache/

# Python bytecode (généré par les scripts de .claude/commands)
__pycache__/
*.pyc
